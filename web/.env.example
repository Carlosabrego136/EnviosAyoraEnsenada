# ============================================================
# Copia este archivo como .env.local y llena tus datos reales.
# NUNCA subas el .env.local real a GitHub.
# ============================================================

# --- Base de datos Aiven (Postgres) ---
# La sacas del panel de Aiven: Service URI o los campos por separado.
DATABASE_URL=postgres://usuario:password@host-aiven:puerto/nombre_bd?sslmode=require

# --- Servicio de WhatsApp (microservicio aparte, ver /whatsapp-service) ---
# URL donde quede corriendo el servicio de WhatsApp (Render, Railway, VPS, etc.)
WHATSAPP_SERVICE_URL=https://tu-servicio-whatsapp.onrender.com
WHATSAPP_SERVICE_TOKEN=cambia-esto-por-un-token-secreto-largo

# --- Seguridad del panel admin (login simple) ---
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave
